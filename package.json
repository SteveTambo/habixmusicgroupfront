{
  "name": "habix-music-group",
  "private": true,
  "scripts": {
    "analyze": "next experimental-analyze --serve",
    "build": "next build --turbopack",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:upload": "opennextjs-cloudflare upload",
    "dev": "next --turbopack",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "npm run format && oxlint --fix",
    "prepare": "next typegen",
    "start": "next start",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@next/playwright": "16.4.2",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "glob": "14.0.3"
    },
    "@node-minify/core": {
      "glob": "14.0.3"
    }
  }
